{
  "manifest_version": 3,
  "name": "Glean Trace Lens",
  "version": "0.1.0",
  "minimum_chrome_version": "118",
  "description": "Inspect a saved Glean chat as an execution waterfall with model and tool inputs and outputs.",
  "permissions": ["activeTab", "debugger", "storage", "alarms"],
  "action": {"default_title": "Inspect this Glean chat"},
  "background": {"service_worker": "background.js", "type": "module"},
  "content_security_policy": {"extension_pages": "script-src 'self'; object-src 'none'"}
}
